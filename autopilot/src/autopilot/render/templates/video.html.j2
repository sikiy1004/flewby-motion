<!doctype html>
<html lang="ja"><head><meta charset="utf-8">
<style>
{{ base_css }}
section { width: 1080px; height: 1920px; position: relative; overflow: hidden; }
/* 背景（不透明・Ken Burns をかける） */
.bg { background: radial-gradient(1200px 900px at 85% 10%, var(--bg2), transparent 70%),
                  radial-gradient(900px 900px at 0% 95%, var(--soft), transparent 70%), var(--bg); }
.bg .ring { position: absolute; border-radius: 50%; border: 3px solid var(--line); }
/* 前景（透過 PNG）。セーフゾーン: 上 220 / 下 420 / 右 160 を避ける。字幕は y=1240〜1480 */
.fg { background: transparent; }
.fg .top { position: absolute; left: 80px; right: 160px; top: 230px; display: flex; justify-content: space-between; align-items: center; }
.fg .top .no { font: 800 32px "InterX"; color: var(--sub); }
.fg .area { position: absolute; left: 80px; right: 160px; top: 330px; height: 840px; display: flex; flex-direction: column; justify-content: center; }
.hook { font: 800 118px/1.2 "NotoJP"; word-break: keep-all; overflow-wrap: anywhere; }
.hook em { font-style: normal; color: var(--accent); }
.sub { font: 700 42px/1.5 "NotoJP"; color: var(--sub); margin-top: 36px; }
.card { background: var(--surface); border-radius: 44px; padding: 56px 56px; box-shadow: 0 30px 80px rgba(0,0,0,.08); }
.card .rk { font: 800 120px/1 "InterX", "NotoJP"; color: var(--accent); }
.card .rk span { font: 800 46px "NotoJP"; }
.card .pn { font: 800 74px/1.25 "NotoJP"; margin: 26px 0 30px; }
.card .price { font: 800 124px/1 "InterX"; }
.card .price span { font: 800 44px "NotoJP"; margin-left: 6px; }
.card .rating { display: flex; align-items: center; gap: 18px; margin: 32px 0 30px; font: 700 38px "NotoJP"; color: var(--sub); }
.card .rating b { font: 800 52px "InterX"; color: var(--ink); }
.card .tag { font-size: 34px; height: 62px; }
.tipn { font: 800 40px "InterX"; color: var(--accent); letter-spacing: .1em; }
.tipt { font: 800 96px/1.25 "NotoJP"; margin-top: 20px; }
.tipb { margin-top: 44px; background: var(--surface); border-radius: 36px; padding: 44px 48px; font: 700 46px/1.6 "NotoJP"; }
.pick { background: var(--surface); border-radius: 30px; padding: 30px 40px; margin-bottom: 22px; }
.pick .pl { font: 800 30px "NotoJP"; color: var(--accent); }
.pick .pv { font: 800 50px/1.3 "NotoJP"; margin-top: 6px; }
.cta-big { font: 800 88px/1.25 "NotoJP"; }
.cta-big em { font-style: normal; color: var(--accent); }
.cta-box { margin-top: 56px; background: var(--surface); border-radius: 34px; padding: 44px; font: 700 46px/1.55 "NotoJP"; }
.cta-box b { color: var(--accent); font-family: "InterX", "NotoJP"; }
.credit { position: absolute; left: 80px; top: 1185px; font: 700 24px "NotoJP"; color: var(--sub); opacity: .85; }
</style></head>
<body class="theme-{{ theme }}">
<section class="bg" id="bg">
  <div class="ring" style="width:900px;height:900px;right:-380px;top:-260px"></div>
  <div class="ring" style="width:600px;height:600px;left:-260px;bottom:120px"></div>
</section>
{% for s in scenes %}
<section class="fg" id="scene-{{ loop.index0 }}">
  <div class="top"><span class="pr">PR</span><span class="no">No.{{ '%03d' % post_no }}</span></div>
  <div class="area">
  {% if s.type == 'hook' %}
    <div><span class="chip">{{ genre }}</span></div>
    <div class="hook" style="margin-top:40px">{{ s.hook_html | safe }}</div>
    <div class="sub">{{ s.subtitle | jp }}</div>
  {% elif s.type == 'product' %}
    {% set p = s.product %}
    <div class="card">
      <div class="rk">{{ s.label_main }}<span>{{ s.label_suffix }}</span></div>
      <div class="pn">{{ p.name | jp }}</div>
      <div class="price num">{{ '{:,}'.format(p.price) }}<span>円</span></div>
      <div class="rating"><b>★{{ '%.2f' % p.review_avg }}</b>レビュー {{ '{:,}'.format(p.review_count) }}件</div>
      <div>{% for f in p.features[:3] %}<span class="tag">{{ f }}</span>{% endfor %}</div>
    </div>
  {% elif s.type == 'tip' %}
    <div class="tipn">POINT {{ s.n }}</div>
    <div class="tipt">{{ s.title | jp }}</div>
    <div class="tipb">{{ s.body | jp }}</div>
  {% elif s.type == 'picks' %}
    {% for k in s.picks %}
    <div class="pick"><div class="pl">{{ k.label }}</div><div class="pv">{{ k.name | jp }}</div></div>
    {% endfor %}
  {% elif s.type == 'cta' %}
    <div class="cta-big">{{ "比べるときのために" | jp }}<br><em>保存</em>してね</div>
    <div class="cta-box">商品リンクはプロフィールの<br>リンク → <b>No.{{ '%03d' % post_no }}</b></div>
  {% endif %}
  </div>
  {% if loop.last and credit %}<div class="credit">{{ credit }}</div>{% endif %}
</section>
{% endfor %}
</body></html>
