# ============================================================
#  autopilot の環境変数（ローカル運用時は .env にコピーして記入）
#  GitHub Actions で動かす場合は、同じ名前で Secrets / Variables に登録します（README 参照）
# ============================================================

# --- 必須 ---------------------------------------------------
# トークン暗号化キー（`autopilot keygen` で生成した値）
AUTOPILOT_SECRET_KEY=
# 楽天ウェブサービス（https://webservice.rakuten.co.jp/）のアプリID / アフィリエイトID
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=
# 楽天側でアクセスキーの指定が必要になった場合のみ
RAKUTEN_ACCESS_KEY=
# Instagram（プロアカウント）の長期アクセストークン。IG_USER_ID は空なら自動取得
IG_ACCESS_TOKEN=
IG_USER_ID=
# Facebook ページ経由で連携した場合のみ graph.facebook.com
IG_GRAPH_HOST=graph.instagram.com

# --- メディア公開（GitHub Pages の公開用リポジトリ） -----------
MEDIA_HOST_BACKEND=github_pages
MEDIA_REPO=your-name/your-links
MEDIA_BASE_URL=https://your-name.github.io/your-links
MEDIA_REPO_TOKEN=

# --- 任意（品質・安定性が上がる） ------------------------------
# LLM（無料枠）。いずれも無ければテンプレ文で投稿を続けます
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# ローカルLLM（Ollama）を使う場合: http://localhost:11434
OLLAMA_HOST=
# 冒頭シーンの背景動画（Pexels 無料API）
PEXELS_API_KEY=
# Amazon アソシエイトのトラッキングID（例: yourid-22）
AMAZON_ASSOCIATE_TAG=
# 失敗通知・週次レポート
DISCORD_WEBHOOK_URL=
# 音声合成エンジン
VOICEVOX_URL=http://localhost:50021

# --- TikTok（Direct Post 審査通過後） ------------------------
TIKTOK_ENABLED=false
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- 動作モード -----------------------------------------------
# true にすると生成・公開まで行い、SNS への投稿だけ行わない（試運転用）
AUTOPILOT_DRY_RUN=false
