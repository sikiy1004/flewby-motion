{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "product.schema.json",
  "title": "Product",
  "type": "object",
  "required": ["id", "category", "brand", "name", "price", "image", "specs", "points"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "英小文字・数字・ハイフン。画像ファイル名にも使う" },
    "category": { "type": "string", "description": "カテゴリ（日本語）例: 美顔器" },
    "categoryEn": { "type": "string", "description": "カテゴリ（英語）例: EMS Facial Device" },
    "brand": { "type": "string" },
    "name": { "type": "string", "description": "商品名（英字表記）" },
    "nameJa": { "type": "string", "description": "商品名（日本語表記）" },
    "price": { "type": "integer", "minimum": 0, "description": "税込の参考価格（円）" },
    "image": { "type": "string", "description": "元写真のパス（プロジェクトからの相対パス）" },
    "displayHeight": { "type": "integer", "minimum": 100, "maximum": 900, "description": "表紙での商品の高さ px（省略時はトークンの値）" },
    "specs": { "type": "object", "maxProperties": 6, "additionalProperties": { "type": "string" }, "description": "{ 項目名: 値 }。表示順は記述順" },
    "points": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "maxLength": 20 } },
    "links": { "type": "object", "properties": { "rakuten": { "type": "string" }, "amazon": { "type": "string" } }, "additionalProperties": { "type": "string" } }
  }
}
