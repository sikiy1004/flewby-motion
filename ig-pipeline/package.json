{
  "name": "ig-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Instagram beauty-gadget post design pipeline (tokens \u2192 HTML/CSS templates \u2192 PNG)",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "assets": "npm run assets:aurora && npm run assets:paint",
    "assets:aurora": ".venv/bin/python generators/aurora.py",
    "assets:paint": ".venv/bin/python generators/paint.py",
    "board": "npm run tokens && node pipeline/shot.mjs docs/board/step1.html docs/previews/step1-board.png --width 1600 --full",
    "build": "node pipeline/build.mjs",
    "assets:mock": ".venv/bin/python generators/mock_products.py",
    "cutout": ".venv/bin/python pipeline/cutout.py",
    "all": "npm run tokens && npm run validate && npm run cutout && npm run build",
    "ps:remove-bg": "bash scripts/photoshop/run.sh remove-bg",
    "ps:export": "bash scripts/photoshop/run.sh export-cutout",
    "validate": "node pipeline/validate.mjs",
    "preview": "node pipeline/preview.mjs",
    "csv:import": "node pipeline/csv.mjs import",
    "csv:export": "node pipeline/csv.mjs export",
    "research:rakuten": "node pipeline/research/rakuten.mjs",
    "research:evidence": "node pipeline/research/evidence.mjs",
    "research:ideas": "node pipeline/research/ideas.mjs",
    "research:approve": "node pipeline/research/approve.mjs",
    "research:lint": "node pipeline/research/lint.mjs",
    "research:draft": "node pipeline/research/draft.mjs",
    "research:install": "node pipeline/research/install.mjs",
    "research:sample": "node pipeline/research/sample.mjs",
    "research:calendar": "node pipeline/research/calendar.mjs",
    "research:competitors": "node pipeline/research/competitors.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "nunjucks": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
