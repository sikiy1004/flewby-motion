# Copy to .env and fill in (never commit .env). Read by npm run research:rakuten.
# 楽天ウェブサービス（https://webservice.rakuten.co.jp/）のアプリ情報
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# アプリの「許可されたWebサイト」に登録したドメインを https:// 付きで（Referer として送る）
RAKUTEN_REFERER=
# 任意：楽天アフィリエイトID（入れると affiliateUrl が返る）
RAKUTEN_AFFILIATE_ID=
